<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- This app does not track users across apps or websites -->
    <key>NSPrivacyTracking</key>
    <false/>

    <!-- No third-party tracking domains used -->
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- No personal data collected -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- APIs accessed by this app -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- UserDefaults / localStorage — used to persist game save data (score, coins, owned ships) -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: Accessed to read/write data accessible only to this app -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
